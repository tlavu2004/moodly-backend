# Non-secret OpenAPI generation fixtures. Use unquoted KEY=VALUE properties syntax.
# Optional .env.docs can override these defaults; this is tooling, not a fourth environment.
SERVER_PORT=8082
DOCS_MONGODB_URI=mongodb://localhost:27017/moodly_docs_fixture
DOCS_ELASTICSEARCH_URIS=http://127.0.0.1:9200
DOCS_JWK_SET_URI=http://127.0.0.1:65535/docs-jwks
DOCS_ENTRIES_COLLECTION_NAME=daily_entries
DOCS_CDC_STREAM_ID=daily_entries
DOCS_CDC_MAINTENANCE_KEY=docs-maintenance-key
DOCS_CDC_RETRY_MAX_ATTEMPTS=3
DOCS_CDC_RETRY_INITIAL_BACKOFF_MS=200
DOCS_CDC_REINDEX_BATCH_SIZE=250
DOCS_SEARCH_INDEX_NAME=daily_entries_search_docs
DOCS_SEARCH_MAPPING_RESOURCE=classpath:elasticsearch/daily_entries_search.json
DOCS_CLOUDINARY_CLOUD_NAME=docs-cloud
DOCS_CLOUDINARY_API_KEY=docs-api-key
DOCS_CLOUDINARY_API_SECRET=docs-api-secret
