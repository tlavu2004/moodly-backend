# Local backend HTTP port
SERVER_PORT=8080

# MongoDB
MONGODB_VERSION=8.0.34@sha256:b9924c330a8bbc5800fe9c69f04a84e221eca7b28fd049a0354147d9908fa142
# Temporary kernel compatibility workaround; see shared-infrastructure-isolation.md.
MONGODB_GLIBC_TUNABLES=glibc.pthread.rseq=1
MONGODB_HOST=localhost
MONGODB_CONTAINER_HOST=localhost
MONGODB_PORT=27017
MONGODB_CONTAINER_PORT=27017
MONGODB_DATABASE=moodly_local
MONGODB_REPLICA_SET=rs0
MONGODB_REPLICA_ADVERTISED_HOST=localhost

# Elasticsearch
ELASTICSEARCH_HOST=localhost
ELASTICSEARCH_CONTAINER_HOST=localhost
ELASTICSEARCH_PORT=9200
ELASTICSEARCH_CONTAINER_PORT=9200
ELASTICSEARCH_HEAP_SIZE=512m

# CDC and search projection
MOODLY_ENTRIES_COLLECTION_NAME=daily_entries
MOODLY_CDC_STREAM_ID=daily_entries
MOODLY_CDC_ENABLED=true
# Shared-secret guard for local CDC maintenance; production also requires an operator JWT.
MOODLY_CDC_MAINTENANCE_KEY=
MOODLY_CDC_RETRY_MAX_ATTEMPTS=3
MOODLY_CDC_RETRY_INITIAL_BACKOFF_MS=200
MOODLY_CDC_REINDEX_BATCH_SIZE=250
MOODLY_SEARCH_INDEX_NAME=daily_entries_search
MOODLY_SEARCH_INDEX_MAPPING_RESOURCE=classpath:elasticsearch/daily_entries_search.json
MOODLY_SEARCH_INDEX_INITIALIZATION_ENABLED=true

# Optional fixed-account reset endpoint for local Playwright runs (keep the token private).
MOODLY_E2E_RESET_ENABLED=false
MOODLY_E2E_RESET_TOKEN=
MOODLY_E2E_USER_ID=synthetic|moodly-playwright-e2e

# Auth0 local development (server-side resource-server configuration)
AUTH0_ISSUER_URI=
AUTH0_AUDIENCE=

# Cloudinary avatar uploads (keep the API secret in the ignored .env.local only)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_PRESET=
CLOUDINARY_FOLDER=moodly/local

# Comma-separated browser origins permitted to call the local API
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173

# HTTP rate limiting
MOODLY_RATE_LIMIT_ENABLED=false
MOODLY_RATE_LIMIT_REQUESTS=120
MOODLY_RATE_LIMIT_WINDOW=60s
MOODLY_RATE_LIMIT_MAX_SUBJECTS=10000
