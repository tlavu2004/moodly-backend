# MongoDB
MONGODB_VERSION=
MONGODB_HOST=
MONGODB_CONTAINER_HOST=
MONGODB_SERVICE_HOST=
MONGODB_PORT=
MONGODB_CONTAINER_PORT=
MONGODB_DATABASE=
MONGODB_REPLICA_SET=
MONGODB_REPLICA_ADVERTISED_HOST=

# Elasticsearch
ELASTICSEARCH_VERSION=
ELASTICSEARCH_HOST=
ELASTICSEARCH_CONTAINER_HOST=
ELASTICSEARCH_PORT=
ELASTICSEARCH_CONTAINER_PORT=
ELASTICSEARCH_HEAP_SIZE=

# CDC and search projection
MOODLY_ENTRIES_COLLECTION_NAME=
MOODLY_CDC_STREAM_ID=
MOODLY_CDC_ENABLED=
# Protects POST /internal/cdc/reindex until Phase 3 supplies admin authentication.
MOODLY_CDC_MAINTENANCE_KEY=
MOODLY_CDC_RETRY_MAX_ATTEMPTS=
MOODLY_CDC_RETRY_INITIAL_BACKOFF_MS=
MOODLY_CDC_REINDEX_BATCH_SIZE=
MOODLY_SEARCH_INDEX_NAME=
MOODLY_SEARCH_INDEX_MAPPING_RESOURCE=
MOODLY_SEARCH_INDEX_INITIALIZATION_ENABLED=

# Auth0 local development (server-side resource-server configuration)
AUTH0_ISSUER_URI=
AUTH0_AUDIENCE=

# Cloudinary avatar uploads (keep the API secret in the ignored .env.local only)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_PRESET=
CLOUDINARY_AVATAR_FOLDER=

# Comma-separated browser origins permitted to call the local API
APP_CORS_ALLOWED_ORIGINS=
