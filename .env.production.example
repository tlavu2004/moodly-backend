# ==============================================================================
# Moodly Backend — Production Environment Variables Template
# ==============================================================================
# Copy this template or use it as a reference when configuring the Render
# Environment Group ('moodly-secrets') or hosting provider secrets store.
# NEVER commit real production credentials or .env.production to source control.
# ==============================================================================

# --- Spring & Server Configuration ---
SPRING_PROFILES_ACTIVE=prod
PORT=8080

# --- MongoDB Atlas (Replica Set Required for Oplog CDC) ---
# Example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/moodly_prod?retryWrites=true&w=majority
MONGODB_URI=

# --- Elasticsearch (Remote / Searchly Cluster) ---
# Example: https://my-searchly-instance.searchly.com
ELASTICSEARCH_URIS=
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=

# --- Auth0 Security (OAuth2 / RS256 JWT Resource Server) ---
# AUTH0_ISSUER_URI must include https:// and the trailing slash
# Example: https://dev-xxxx.us.auth0.com/
AUTH0_ISSUER_URI=
# Unique API Audience identifier registered in Auth0
# Example: https://api.moodly.com
AUTH0_AUDIENCE=

# --- Cloudinary CDN (Avatar Storage & Uploads) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_PRESET=moodly_prod_signed
CLOUDINARY_FOLDER=moodly/prod
CLOUDINARY_CONNECT_TIMEOUT=2s
CLOUDINARY_REQUEST_TIMEOUT=5s

# --- CORS Security ---
# Comma-separated list of allowed production frontend domains (NO trailing slash)
# Example: https://moodly.vercel.app,https://moodly-app.onrender.com
APP_CORS_ALLOWED_ORIGINS=

# --- Change Data Capture (CDC) & Search Configuration ---
MOODLY_ENTRIES_COLLECTION_NAME=daily_entries
MOODLY_CDC_STREAM_ID=daily_entries
MOODLY_CDC_ENABLED=true
# Secret maintenance key required alongside operator JWT for /internal/cdc endpoints
MOODLY_CDC_MAINTENANCE_KEY=
MOODLY_CDC_ADMIN_AUTHORITY=SCOPE_moodly:admin
MOODLY_CDC_RETRY_MAX_ATTEMPTS=3
MOODLY_CDC_RETRY_INITIAL_BACKOFF_MS=200
MOODLY_CDC_REINDEX_BATCH_SIZE=250
MOODLY_SEARCH_INDEX_NAME=daily_entries_search
MOODLY_SEARCH_INDEX_MAPPING_RESOURCE=classpath:elasticsearch/daily_entries_search.json
MOODLY_SEARCH_INDEX_INITIALIZATION_ENABLED=true

# --- HTTP Rate Limiting (Token Bucket) ---
MOODLY_RATE_LIMIT_ENABLED=true
MOODLY_RATE_LIMIT_REQUESTS=120
MOODLY_RATE_LIMIT_WINDOW=60s
MOODLY_RATE_LIMIT_MAX_SUBJECTS=10000

# --- E2E Reset (Hard-disabled in production by @Profile("!prod & !production")) ---
MOODLY_E2E_RESET_ENABLED=false
