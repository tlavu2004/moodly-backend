# Manual test application settings on shared moodly-local infrastructure.
# Infrastructure coordinates come only from .env.local (or its example).
# Reserved test targets are read from this file and validated against a fixed allowlist.
MONGODB_DATABASE=moodly_test

# Manual backend HTTP port (local backend keeps 8080)
SERVER_PORT=8081

# CDC and search projection
MOODLY_ENTRIES_COLLECTION_NAME=daily_entries
MOODLY_CDC_STREAM_ID=daily_entries
MOODLY_CDC_MAINTENANCE_KEY=
MOODLY_CDC_ENABLED=false
MOODLY_CDC_RETRY_MAX_ATTEMPTS=3
MOODLY_CDC_RETRY_INITIAL_BACKOFF_MS=200
MOODLY_CDC_REINDEX_BATCH_SIZE=250
MOODLY_SEARCH_INDEX_NAME=daily_entries_search_test
MOODLY_SEARCH_INDEX_MAPPING_RESOURCE=classpath:elasticsearch/daily_entries_search.json
MOODLY_SEARCH_INDEX_INITIALIZATION_ENABLED=false

# HTTP rate limiting
MOODLY_RATE_LIMIT_ENABLED=false
MOODLY_RATE_LIMIT_REQUESTS=120
MOODLY_RATE_LIMIT_WINDOW=60s
MOODLY_RATE_LIMIT_MAX_SUBJECTS=10000

# Non-secret automated-test fixtures, imported by application-test.yaml.
# TEST_ keys do not replace hosted development credentials in manual mode.
TEST_E2E_RESET_ENABLED=true
TEST_E2E_RESET_TOKEN=test-e2e-reset-token
TEST_E2E_USER_ID=synthetic|moodly-playwright-e2e
TEST_CLOUDINARY_CLOUD_NAME=test-cloud
TEST_CLOUDINARY_API_KEY=test-api-key
TEST_CLOUDINARY_API_SECRET=test-api-secret
TEST_CLOUDINARY_UPLOAD_PRESET=test-upload-preset
TEST_CLOUDINARY_FOLDER=moodly/test
TEST_ENTRIES_COLLECTION_NAME=daily_entries
TEST_CDC_ENABLED=false
TEST_CDC_MAINTENANCE_KEY=test-maintenance-key
TEST_CDC_STREAM_ID=daily_entries
TEST_CDC_RETRY_MAX_ATTEMPTS=3
TEST_CDC_RETRY_INITIAL_BACKOFF_MS=200
TEST_CDC_REINDEX_BATCH_SIZE=250
TEST_SEARCH_MAPPING_RESOURCE=classpath:elasticsearch/daily_entries_search.json
TEST_SEARCH_INITIALIZATION_ENABLED=false
TEST_RATE_LIMIT_ENABLED=false
