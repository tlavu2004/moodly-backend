meta {
  name: Bootstrap authenticated profile
  type: http
  seq: 5
}

put {
  url: {{baseUrl}}/auth/profile
  body: none
  auth: inherit
}

tests {
  test("bootstraps the Auth0 user's application profile", function() {
    expect(res.getStatus()).to.equal(200);
  });
  
  test("returns the verified Auth0 subject", function() {
    const body = res.getBody();
    expect(body.success).to.equal(true);
    expect(body.data.userId).to.be.a("string");
    expect(body.data.userId).not.to.equal("");
  });
}
