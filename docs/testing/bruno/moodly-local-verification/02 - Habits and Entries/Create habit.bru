meta {
  name: Create habit
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/habits
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "name": "Exercise",
    "icon": "🏃",
    "targetFrequency": "daily"
  }
}

script:post-response {
  const body = res.getBody();
  if (res.getStatus() === 201 && body.success && body.data && body.data.id) {
    bru.setEnvVar("habitId", body.data.id, { persist: true });
  }
}

tests {
  test("creates a habit", function() {
    expect(res.getStatus()).to.equal(201);
  });

  test("stores the created habit ID for subsequent requests", function() {
    expect(bru.getEnvVar("habitId")).to.equal(res.getBody().data.id);
  });
}
