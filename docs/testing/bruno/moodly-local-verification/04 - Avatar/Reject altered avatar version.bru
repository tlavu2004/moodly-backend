meta {
  name: Reject altered avatar version
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/me/avatar/confirm
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "publicId": "{{publicId}}",
    "version": {{incorrectAvatarVersion}}
  }
}

tests {
  test("rejects a Cloudinary version that does not match", function() {
    expect(res.getStatus()).to.equal(400);
  });
}
