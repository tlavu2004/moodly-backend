meta {
  name: Reject unsupported avatar type
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/me/avatar/upload-signature
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "contentType": "image/gif",
    "sizeBytes": 1024
  }
}

tests {
  test("rejects a GIF avatar", function() {
    expect(res.getStatus()).to.equal(400);
  });
}
