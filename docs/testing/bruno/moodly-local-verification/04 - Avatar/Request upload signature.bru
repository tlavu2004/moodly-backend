meta {
  name: Request avatar upload signature
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/me/avatar/upload-signature
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "contentType": "image/png",
    "sizeBytes": 1024
  }
}

script:post-response {
  const body = res.getBody();
  if (res.getStatus() === 200 && body.success && body.data) {
    bru.setEnvVar("cloudinaryUploadUrl", body.data.uploadUrl);
    bru.setEnvVar("cloudinaryApiKey", body.data.apiKey);
    bru.setEnvVar("cloudinaryTimestamp", String(body.data.timestamp));
    bru.setEnvVar("cloudinarySignature", body.data.signature);
    bru.setEnvVar("cloudinaryUploadPreset", body.data.uploadPreset);
    bru.setEnvVar("publicId", body.data.publicId, { persist: true });
  }
}

tests {
  test("returns a signed Cloudinary upload payload", function() {
    expect(res.getStatus()).to.equal(200);
    expect(bru.getEnvVar("publicId")).to.equal(res.getBody().data.publicId);
  });
}
