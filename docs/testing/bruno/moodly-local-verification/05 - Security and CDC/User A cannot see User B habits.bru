meta {
  name: User A cannot see User B habits
  type: http
  seq: 9
}

get {
  url: {{baseUrl}}/habits
  body: none
  auth: inherit
}

tests {
  test("does not return user B's isolated habit", function() {
    expect(res.getStatus()).to.equal(200);
    expect(JSON.stringify(res.getBody())).not.to.contain("User B isolated habit");
  });
}
