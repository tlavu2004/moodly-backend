meta {
  name: User A search is isolated from User B
  type: http
  seq: 10
}

get {
  url: {{baseUrl}}/entries/search?q=userbzephyrneedle&from=2026-09-01&to=2026-09-12
  body: none
  auth: inherit
}

tests {
  test("does not return user B's isolated entry", function() {
    expect(res.getStatus()).to.equal(200);
    expect(JSON.stringify(res.getBody())).not.to.contain("userbzephyrneedle");
  });
}
