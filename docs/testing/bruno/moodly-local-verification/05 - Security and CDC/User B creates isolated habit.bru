meta {
  name: User B creates isolated habit
  type: http
  seq: 13
}

post {
  url: {{baseUrl}}/habits
  body: json
  auth: oauth2
}

headers {
  Content-Type: application/json
}

auth:oauth2 {
  grant_type: authorization_code
  callback_url: {{auth0CallbackUrl}}
  authorization_url: https://{{auth0Domain}}/authorize
  access_token_url: https://{{auth0Domain}}/oauth/token
  refresh_token_url: 
  client_id: {{auth0ClientId}}
  client_secret: 
  scope: openid profile email
  state: 
  pkce: true
  credentials_placement: body
  credentials_id: moodly-user-b-local
  token_source: access_token
  token_placement: header
  token_header_prefix: Bearer
  auto_fetch_token: true
  auto_refresh_token: false
}

auth:oauth2:additional_params:auth_req:queryparams {
  audience: {{auth0Audience}}
  prompt: login
}

body:json {
  {
    "name": "User B isolated habit",
    "icon": "📚",
    "targetFrequency": "daily"
  }
}

script:post-response {
  const body = res.getBody();
  if (res.getStatus() === 201 && body.success && body.data && body.data.id) {
    bru.setEnvVar("userBHabitId", body.data.id, { persist: true });
  }
}

tests {
  test("creates a habit owned by user B", function() {
    expect(res.getStatus()).to.equal(201);
  });
}
