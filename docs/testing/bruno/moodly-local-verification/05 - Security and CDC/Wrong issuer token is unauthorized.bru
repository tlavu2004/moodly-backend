get {
  url: {{baseUrl}}/habits
  body: none
  auth: bearer
}

auth:bearer {
  token: {{wrongIssuerAccessToken}}
}

tests {
  test("returns unauthorized for an unexpected issuer", function() {
    expect(res.getStatus()).to.equal(401);
  });
}
