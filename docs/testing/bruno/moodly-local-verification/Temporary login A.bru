meta {
  name: Temporary login A
  type: http
  seq: 99
}

get {
  url: http://127.0.0.1:8080/habits
  body: none
  auth: oauth2
}

auth:oauth2 {
  grant_type: authorization_code
  callback_url: {{auth0CallbackUrl}}
  authorization_url: https://{{auth0Domain}}/authorize
  access_token_url: https://{{auth0Domain}}/oauth/token
  refresh_token_url: 
  client_id: {{auth0ClientId}}
  client_secret: 
  scope: openid profile email
  state: 
  pkce: true
  credentials_placement: body
  credentials_id: moodly-quota-check-a-20261106
  token_source: access_token
  token_placement: header
  token_header_prefix: Bearer
  auto_fetch_token: true
  auto_refresh_token: false
}

auth:oauth2:additional_params:auth_req:queryparams {
  audience: {{auth0Audience}}
  prompt: login
}



tests {
  function subject(token) {
    if (!token) return null;
    const alphabet = 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/';
    const input = token.split('.')[1].replace(/-/g, '+').replace(/_/g, '/');
    let bits = 0, value = 0, decoded = '';
    for (const character of input) {
      const digit = alphabet.indexOf(character);
      if (digit < 0) continue;
      value = (value << 6) | digit;
      bits += 6;
      if (bits >= 8) { bits -= 8; decoded += String.fromCharCode((value >> bits) & 255); }
    }
    return JSON.parse(decoded).sub;
  }
  const a = subject(bru.getOauth2CredentialVar('$oauth2.moodly-quota-check-a-20261106.access_token'));
  bru.setVar('quotaCheckSubjectA', a);
  test('A has a verified HTTP 200 and a subject', function () {
    expect(res.getStatus()).to.equal(200);
    expect(Boolean(a)).to.equal(true);
  });
}